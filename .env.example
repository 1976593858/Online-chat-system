# Online Chat System 环境变量配置
# 复制此文件为 .env 并修改实际值

# 服务端口
SERVER_PORT=8080

# MySQL 数据库配置
DB_URL=jdbc:mysql://localhost:3306/online_chat?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai&useSSL=false&allowPublicKeyRetrieval=true
DB_USERNAME=root
DB_PASSWORD=123456

# JWT 配置
# 生产环境务必修改为高强度随机字符串（至少 256 位）
JWT_SECRET=change-me-to-a-random-secret-at-least-32-chars
JWT_ISSUER=online-chat
# JWT 过期时间（毫秒），默认 24 小时
JWT_EXPIRE_MILLIS=86400000

# MyBatis SQL 日志（生产环境建议关闭）
MYBATIS_LOG_IMPL=org.apache.ibatis.logging.stdout.StdOutImpl

# 前端 WebSocket 地址（留空使用相对路径，由 Nginx/Vite 代理自动处理）
VITE_WS_BASE_URL=
VITE_API_BASE_URL=
